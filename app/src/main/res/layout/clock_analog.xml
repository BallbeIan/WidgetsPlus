<?xml version="1.0" encoding="utf-8"?>
<!-- Analog clock. AnalogClock turns its own hands, and scales the drawables down to fit the widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <AnalogClock
        android:id="@+id/clock_analog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:dial="@drawable/clock_dial"
        android:hand_hour="@drawable/clock_hand_hour"
        android:hand_minute="@drawable/clock_hand_minute" />
</FrameLayout>
